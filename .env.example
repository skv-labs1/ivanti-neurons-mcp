# ── DEX (Neurons Platform) ──────────────────────────────────
# Base URL of your Neurons tenant, e.g. https://tenant.ivanticloud.com
NEURONS_BASE_URL=https://YOUR-TENANT.ivanticloud.com
# Bearer token – paste from the bookmarklet or OAuth flow
NEURONS_BEARER_TOKEN=

# ── ITSM ────────────────────────────────────────────────────
# Base URL of your ITSM instance, e.g. https://tenant.saasit.com
ITSM_BASE_URL=https://YOUR-TENANT.saasit.com
# REST API key from ITSM > Configure > Security Controls > API Keys
ITSM_API_KEY=

# ── MDM ─────────────────────────────────────────────────────
# Base URL of your MDM instance, e.g. https://tenant.mobileiron.com
MDM_BASE_URL=https://YOUR-TENANT.mobileiron.com
# Admin username and password for Basic Auth
MDM_USERNAME=
MDM_PASSWORD=
